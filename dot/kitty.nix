{ ... }:
{
	# Colors are generated by serpantinum (matugen) into colors.conf.
	programs.kitty = {
		enable = true;
		settings = {
			confirm_os_window_close = 0; 	# close without confirmation
			background_opacity = "0.50"; 	# translucent background
		};
		extraConfig = ''
			include ~/.config/kitty/colors.conf
		'';
	};
}
